{
  "name": "@a11y-lab/benchmark",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Benchmark controlado de pares base-mutante y harness que los monta",
  "scripts": {
    "harness": "vite",
    "build": "vite build",
    "serve": "vite preview --port 5273 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "axe": "tsx scripts/axe-check.ts",
    "verify": "vite build && tsx scripts/axe-check.ts",
    "measure": "tsx scripts/measure.ts",
    "inspect": "tsx scripts/inspect.ts",
    "verify-gt": "tsx scripts/verify-ground-truth.ts",
    "prompt-sizes": "tsx scripts/prompt-sizes.ts",
    "preflight": "tsx scripts/preflight.ts",
    "pilot-format": "tsx scripts/pilot-format.ts",
    "capture-all": "tsx scripts/capture-all.ts",
    "run-analysis": "tsx scripts/run-analysis.ts",
    "token-probe": "tsx scripts/token-probe.ts",
    "pr-check": "tsx scripts/pr-check.ts",
    "pr-selftest": "tsx scripts/pr-selftest.ts"
  },
  "dependencies": {
    "@a11y-lab/framework": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@a11y-lab/ui": "workspace:*",
    "@a11y-lab/analysis": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "vite": "5.4.9",
    "axe-core": "4.10.0",
    "playwright": "1.48.2"
  }
}
