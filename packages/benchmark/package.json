{
  "name": "@a11y-lab/benchmark",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Benchmark controlado de pares base-mutante y harness que los monta",
  "scripts": {
    "harness": "vite",
    "build": "vite build",
    "serve": "vite preview --port 5273 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "axe": "tsx scripts/axe-check.ts",
    "verify": "vite build && tsx scripts/axe-check.ts",
    "measure": "tsx scripts/measure.ts",
    "inspect": "tsx scripts/inspect.ts"
  },
  "dependencies": {
    "@a11y-lab/framework": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@a11y-lab/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "vite": "5.4.9",
    "axe-core": "4.10.0",
    "playwright": "1.48.2"
  }
}
